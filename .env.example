# Frontend/browser-safe values.
# start-localhost.ps1 reads these and serves them as src/config.js.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-browser-safe-publishable-key


# Supabase Edge Function secrets
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key
ADMIN_INVITE_REDIRECT_URL=http://localhost:8080

# Resend email delivery
RESEND_API_KEY=re_your-resend-api-key
EMAIL_DISPATCH_SECRET=change-this-long-random-secret
EMAIL_FROM="Mesim i Qarte <onboarding@resend.dev>"
EMAIL_REPLY_TO=
EMAIL_APP_URL=http://localhost:8080
# Useful while testing without a verified sender domain. Resend may only allow
# onboarding@resend.dev to send to your own verified account email.
EMAIL_TEST_RECIPIENT=your-resend-account-email@example.com
EMAIL_DISPATCH_LIMIT=25
EMAIL_MAX_ATTEMPTS=3

# Optional local PowerShell fallback server
PORT=8080
