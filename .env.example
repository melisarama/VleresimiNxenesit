# Frontend/browser-safe values.
# start-localhost.ps1 reads these and serves them as src/config.js.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-browser-safe-publishable-key

# Supabase Edge Function secrets
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key
ADMIN_INVITE_REDIRECT_URL=http://localhost:8080

# Optional local PowerShell fallback server
PORT=8080
