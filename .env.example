# Frontend/browser-safe values.
# start-localhost.ps1 reads these and serves them as src/config.js.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-browser-safe-publishable-key
STORAGE_API_BASE_URL=https://storage.iliriadigital.com
STORAGE_SERVICE_SECRET=change-this-long-random-storage-secret
STORAGE_ALLOWED_ORIGINS=https://iliriadigital.com,https://www.iliriadigital.com,https://vleresiminxenesit.vercel.app,http://localhost:8080,http://127.0.0.1:8080


# Supabase Edge Function secrets
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here

SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key
ADMIN_INVITE_REDIRECT_URL=https://vleresiminxenesit.vercel.app

# Resend email delivery
RESEND_API_KEY=re_your-resend-api-key
EMAIL_DISPATCH_SECRET=change-this-long-random-secret
# Set either EMAIL_FROM as a full sender string or provide RESEND_FROM_EMAIL.
EMAIL_FROM="Vleresimi i Nxenesit <no-reply@your-verified-domain.example>"
RESEND_FROM_EMAIL=
EMAIL_FROM_NAME=Vleresimi i Nxenesit
EMAIL_REPLY_TO=
EMAIL_APP_URL=https://vleresiminxenesit.vercel.app
# Useful while testing on a restricted sender or free plan.
EMAIL_TEST_RECIPIENT=your-resend-account-email@example.com
EMAIL_DISPATCH_LIMIT=25
EMAIL_MAX_ATTEMPTS=3

# Optional local PowerShell fallback server
PORT=8080
